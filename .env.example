# ─── Variables de entorno de SkyLine Airlines ───────────────
# Renombra este archivo a .env y llena los valores reales

# Puerto del servidor (opcional, default 3000)
PORT=3000

# Clave secreta para las sesiones (cámbiala por algo seguro)
SESSION_SECRET=cambia_esto_por_algo_secreto

# ── MySQL ────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=skyline_airlines

# ── APIs externas ────────────────────────────────────────────
# Obtén tu clave gratis en https://openweathermap.org/api
OPENWEATHER_API_KEY=tu_api_key_de_openweather

# Google Maps / Places (habilita Maps JS API + Places API)
# https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=tu_api_key_de_google_maps

# Stripe (pagos simulados) — usa las claves de prueba (test)
# https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxx
